# Hunter.io API key (free plan: about 50 searches a month). https://hunter.io/api-keys
HUNTER_API_KEY=

# SMTP account the emails are sent from.
# Gmail: turn on 2-step verification, then create an app password at
# https://myaccount.google.com/apppasswords and use it as SMTP_PASSWORD.
# Personal Outlook.com accounts no longer accept password SMTP logins;
# use `coldreach export` instead and send the drafts from Outlook.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
